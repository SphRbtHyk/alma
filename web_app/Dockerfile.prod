# ── Stage 1: build the React/Vite frontend ───────────────────────────────────
FROM node:22-alpine AS frontend

WORKDIR /frontend

COPY web_app/frontend/package*.json ./
RUN npm ci

COPY web_app/frontend/ ./
RUN npm run build


# ── Stage 2: Python backend (serves API + compiled frontend) ──────────────────
FROM python:3.12-slim AS backend

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ build-essential git curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY README.md ./
COPY src/ ./src/

RUN pip install -U pip \
    && pip install --no-cache-dir -e . \
    && pip install --no-cache-dir "fastapi>=0.100.0" "uvicorn[standard]>=0.20.0"

RUN python -m pip install \
    "la-core-web-lg @ https://huggingface.co/latincy/la_core_web_lg/resolve/main/la_core_web_lg-3.8.0-py3-none-any.whl"

COPY web_app/backend/ ./web_app/backend/

# Copy the compiled frontend from Stage 1.
COPY --from=frontend /frontend/dist ./web_app/frontend/dist

WORKDIR /app/web_app/backend

ENV FRONTEND_DIST_DIR=/app/web_app/frontend/dist

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
